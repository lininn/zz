{
  "name": "@lininn/zz",
  "version": "0.1.1",
  "description": "AI coding assistant CLI — zz command",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zai-org/ZCode.git"
  },
  "bin": {
    "zz": "./dist/zcode.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/zcode.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:npm": "node scripts/build-npm-package.mjs",
    "build:desktop-agent": "node scripts/build.mjs --desktop-agent",
    "build:sea": "pnpm --dir ../../../.. exec turbo --skip-infer --cwd apps/zcode-cli run build --filter=!@lininn/zz --force && pnpm build && node scripts/build-sea.mjs --all",
    "sea": "node scripts/build-sea.mjs",
    "upload:sea": "node scripts/upload-sea-smb.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@zcode/adapters": "workspace:*",
    "@zcode/bootstrap": "workspace:*",
    "@zcode/contracts": "workspace:*",
    "@zcode/core": "workspace:*",
    "@zcode/dynamic-workflow-runtime": "workspace:*",
    "@zcode/i18n": "workspace:*",
    "@zcode/provider": "workspace:*",
    "@zcode/provider-node": "workspace:*",
    "@zcode/shared": "workspace:*",
    "@zcode/shared-types": "workspace:*",
    "@zcode/tui": "workspace:*",
    "dotenv": "^17.4.2",
    "playwright-core": "1.59.1"
  }
}
